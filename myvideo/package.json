{
  "name": "myvideo",
  "version": "1.0.0",
  "description": "Standalone prompt-to-video app powered by Remotion and Claude",
  "scripts": {
    "start": "concurrently -n studio,server -c cyan,magenta \"npm run studio\" \"npm run server\"",
    "studio": "remotion studio src/index.ts",
    "server": "tsx server/server.ts",
    "generate": "tsx generate/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@remotion/animation-utils": "4.0.409",
    "@remotion/cli": "4.0.409",
    "@remotion/google-fonts": "4.0.409",
    "@remotion/layout-utils": "4.0.409",
    "concurrently": "^9.1.2",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.409",
    "uuid": "^11.0.0",
    "zod": "^3.23.3",
    "zod-to-json-schema": "3.23.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
